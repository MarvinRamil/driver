# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
**/.expo/
.expo
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# Use /android/* (not /android) so negation for android/fastlane works -
# git cannot re-include files under an excluded parent directory
/ios
/android/*

# Firebase iOS configuration (contains sensitive project info)
# Note: google-services.json is safe to commit (public config)
GoogleService-Info.plist
keystore_base64.txt
release.keystore
release.keystore

# Exception: fastlane configuration files needed for CI/CD
!/android/fastlane/
!/android/fastlane/**


.env