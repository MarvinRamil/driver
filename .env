# Google Maps API Configuration
# Replace 'your_api_key_here' with your actual Google Maps API key from Google Cloud Console
# See docs/plans/google-maps-integration-plan.md for setup instructions
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAl8YvG-k2gOW86s0MtirD4guXzk9hChZQ
# Google Maps API Base URL (optional - defaults to https://maps.googleapis.com/maps/api)
# Only change this if you need to use a different API endpoint (e.g., proxy, custom domain)
EXPO_PUBLIC_GOOGLE_MAPS_API_BASE_URL=https://maps.googleapis.com/maps/api

# Map provider: when unset, app defaults to mapbox. Set to google to use Google for directions/geocoding/search.
# EXPO_PUBLIC_MAP_PROVIDER=mapbox
# EXPO_PUBLIC_MAP_PROVIDER=google

# Mapbox – public access token (for map provider when EXPO_PUBLIC_MAP_PROVIDER=mapbox)
# Optional env-specific: EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN_DEVELOPMENT, _STAGING, _PRODUCTION
# See docs/plans/mapbox-migration-plan.md and docs/ENVIRONMENT_VARIABLES.md
