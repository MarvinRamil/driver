# API Configuration (base URL only; do NOT include /api)
EXPO_PUBLIC_API_URL=https://api.mybeeapp.com
EXPO_PUBLIC_API_TIMEOUT=120000
EXPO_PUBLIC_API_DEBUG=false

# Clerk (auth). Leave empty to keep Clerk DISABLED (app uses the legacy auth).
# Set the Clerk Publishable Key to enable Clerk. Get it from the Clerk Dashboard → API Keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Xendit public key (payments)
EXPO_PUBLIC_XENDIT_PUBLIC_KEY=xnd_public_your_key_here

# Google Maps API Configuration
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
EXPO_PUBLIC_GOOGLE_MAPS_API_BASE_URL=https://maps.googleapis.com/maps/api

# Map provider: when unset, app defaults to mapbox. Set to google to use Google for directions/geocoding/search.
# EXPO_PUBLIC_MAP_PROVIDER=mapbox
# EXPO_PUBLIC_MAP_PROVIDER=google

# Mapbox – public access token (for map provider when EXPO_PUBLIC_MAP_PROVIDER=mapbox)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# MQTT (driver location streaming)
EXPO_PUBLIC_MQTT_TOPIC_PREFIX=dev/beelogistics/drivers
EXPO_PUBLIC_MQTT_HOST=your_mqtt_host
EXPO_PUBLIC_MQTT_PORT=80
EXPO_PUBLIC_MQTT_USERNAME=your_mqtt_username
EXPO_PUBLIC_MQTT_PASSWORD=your_mqtt_password
EXPO_PUBLIC_MQTT_USE_SSL=true
